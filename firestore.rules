rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'ohihio@gmail.com';
    }

    function isTaskCreator(task) {
      return isSignedIn() && task.createdBy == request.auth.uid;
    }

    function isMemberOwner(memberKey) {
      return memberKey is string
        && exists(/databases/$(database)/documents/work_progress_members/$(memberKey))
        && get(/databases/$(database)/documents/work_progress_members/$(memberKey)).data.email == request.auth.token.email;
    }

    function isTaskAssignee(task) {
      return isSignedIn() && isMemberOwner(task.assigneeKey);
    }

    function isVisibleTask(task) {
      return task.visibility == 'public'
        || isTaskCreator(task)
        || isAdmin()
        || isTaskAssignee(task);
    }

    function isProgressOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['progressEntries', 'updatedAt']);
    }

    function isFreshTaskCreate() {
      return request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByEmail == request.auth.token.email
        && request.resource.data.archived == false
        && request.resource.data.progressEntries == null;
    }

    match /mail_receipts/{document} {
      allow read, write: if true;
    }
    match /outgoing_mail/{document} {
      allow read, write: if true;
    }
    match /senders/{document} {
      allow read, write: if true;
    }
    match /tool_manager_categories/{document} {
      allow read, write: if true;
    }
    match /tool_manager_tools/{document} {
      allow read, write: if true;
    }
    match /tool_manager_history/{document} {
      allow read, write: if true;
    }
    match /video_episodes/{document} {
      allow read, write: if true;
    }
    match /ai_usage/{document} {
      allow read, write: if true;
    }
    match /admin_tools/{document} {
      allow read, write: if isAdmin();
    }
    // 每月檢查（公務車 + 銀行保險箱）：docId = YYYY-MM，只有管理者可讀寫
    match /monthly_check/{monthId} {
      allow read, write: if isAdmin();
    }
    match /work_progress/{taskId} {
      allow read: if isSignedIn() && isVisibleTask(resource.data);
      allow create: if isSignedIn() && isFreshTaskCreate();
      allow update: if isSignedIn()
        && (
          isTaskCreator(resource.data)
          || isAdmin()
          || (isTaskAssignee(resource.data) && isProgressOnlyUpdate())
        );
      allow delete: if isSignedIn()
        && (isTaskCreator(resource.data) || isAdmin());
    }
    match /work_progress_members/{memberId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow write: if isAdmin();
    }
    match /work_progress_categories/{catId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
